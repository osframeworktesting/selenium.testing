        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="שלום! מטרת הניסוי היא ללמוד על עיבוד ויזואלי מופשט בסביבה רועשת.&amp;#10;בניסוי יוצגו צורות סגולות שנעות לתוך ומחוץ לריבוע אפור שיסתיר אותן.&amp;#10; הצורות נראות דומות אחת לשניה, אבל ישנם הבדלים ביניהן.&amp;#10;&amp;#10;משימתך היא, עבור כל צורה שיוצאת מאחורי הריבוע האפור,&amp;#10; לשפוט האם ה&quot;ראש&quot; של הצורה פונה למטה או למעלה.&amp;#10;אם הראש פונה למעלה יש ללחוץ על K&amp;#10;אם הראש פונה למטה יש ללחוץ על D" valType="str" updates="constant" name="text"/>
