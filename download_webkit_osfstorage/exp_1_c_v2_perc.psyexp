    <Param val="{'participant': '', 'subject num': '', 'run': '', 'age': '', 'gender': '', 'room': 'E', 'session': '001', 'version': 'percept'}" valType="code" updates="None" name="Experiment info"/>
    <Param val="True" valType="bool" updates="None" name="Force stereo"/>
