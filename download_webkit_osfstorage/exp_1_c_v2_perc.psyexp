        <Param val="greeble_img" valType="code" updates="None" name="name"/>
        <Param val="1" valType="num" updates="constant" name="opacity"/>
        <Param val="np.random.choice(np.arange(-30,30))+greeble_oreintation" valType="num" updates="set every repeat" name="ori"/>
        <Param val="(curr_x_loc,curr_y_loc)" valType="list" updates="set every frame" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
