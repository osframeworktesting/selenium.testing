      </TextComponent>
    </Routine>
    <Routine name="set_block">
      <CodeComponent name="set_block_code">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="#exp_params&amp;#10;import pandas as pd&amp;#10;def eng_to_heb(df,wordlist):&amp;#10;    for i in range(len(wordlist)):&amp;#10;        index_of_interest=df[&quot;target_eng&quot;]==wordlist[i]&amp;#10;        wordlist[i]=df[&quot;target_heb&quot;][index_of_interest].item()&amp;#10;    return list(wordlist)&amp;#10;&amp;#10;def get_answers(df,word):&amp;#10;    index_of_interest=np.array(df[&quot;target_eng&quot;])==word&amp;#10;    if np.sum(index_of_interest)!=1:&amp;#10;        return &quot;nothing&quot;&amp;#10;    correct=df[&quot;correct&quot;][index_of_interest].iloc[0]&amp;#10;    answers=[df[&quot;option1&quot;][index_of_interest].iloc[0],df[&quot;option2&quot;][index_of_interest].iloc[0],df[&quot;option3&quot;][index_of_interest].iloc[0]]&amp;#10;    keys=[&quot;a&quot;,&quot;g&quot;,&quot;l&quot;]&amp;#10;    key = keys[np.where(np.array(answers)==np.array(correct))[0][0]]&amp;#10;    answers.append(key)&amp;#10;    return answers&amp;#10;expInfo[&quot;exp_version&quot;]=&quot;perceptual&quot;&amp;#10;subject_num=int(expInfo[&quot;subject num&quot;])&amp;#10;run=int(expInfo[&quot;run&quot;])&amp;#10;version=&quot;ask_per_target&quot; # &quot;ask_per_target&quot; &quot;ask_per_block&quot;&amp;#10;n_blocks=6 #including training blocks&amp;#10;training_blocks = 3&amp;#10;if run==2: #exclude training if it's the 2nd run&amp;#10;    n_blocks=4&amp;#10;    training_blocks=1&amp;#10;nTrialsInBlock=18&amp;#10;#text_duration=0.35&amp;#10;nTrialsAfterTraining=215&amp;#10;n_correct=0 #count each block for feedback&amp;#10;total_trials=1 #counter&amp;#10;curr_block=0&amp;#10;same_streak=0 #making sure that there are no more than 10 trials without changes&amp;#10;#catch_probability=0.4 #for each trial marked for awareness test&amp;#10;frameRate = 60 #Hz&amp;#10;fadeInTime = 0.1 #seconds&amp;#10;fadeOutTime = 0.1&amp;#10;presentationTime = 0.9  #seconds&amp;#10;presentationTimeAfterTraining = 0.600&amp;#10;targets_in_previous=0&amp;#10;target_count_randomizer = [19,19,19] # number of trials in a block, multiple of length(conditions)&amp;#10;total_probes=np.sum(target_count_randomizer)&amp;#10;SOA=1.9&amp;#10;SOA_AfterTraining = 1.4&amp;#10;max_jitter=0.15 #seconds&amp;#10;&amp;#10;&amp;#10;conditions = np.repeat([&quot;catch&quot;,&quot;real_word&quot;,&quot;real_word&quot;],total_probes/3)&amp;#10;np.random.shuffle(conditions)&amp;#10;&amp;#10;print(subject_num)&amp;#10;np.random.seed(subject_num) # constant order per person for subjects to get different words in the two parts&amp;#10;all_targets_df=pd.read_csv(&quot;emotional_heb_words_sub.csv&quot;).sample(frac=1)[:39]&amp;#10;print(len(all_targets_df))&amp;#10;#targets_translation=pd.read_csv(&quot;words_hebrew_exp1_translation.csv&quot;).sample(frac=1)&amp;#10;reverse_nonwords=pd.read_csv(&quot;reverse_nonwords.csv&quot;)&amp;#10;reverse_nonword=list(reverse_nonwords.sample(1)[&quot;auditory_nonword&quot;])[0] #sample a random nonword for mask&amp;#10;auditory_nonword=list(reverse_nonwords.sample(1)[&quot;auditory_nonword&quot;])[0] #sample a random nonword for mask&amp;#10;&amp;#10;possible_answers = [&quot;פעולה&quot;,&quot;אובייקט קטן&quot;,&quot;תחושה&quot;,&quot;אירוע&quot;,&quot;מזון&quot;,&quot;אדם&quot;,&quot;אובייקט גדול&quot;,&quot;תיאור&quot;,&quot;חיה&quot;,&quot;סימן&quot;]&amp;#10;&amp;#10;backgrounds = [&quot;desert_1.jpg&quot;,&quot;forest_1.jpg&quot;,&quot;city_1.jpg&quot;,&quot;jungle_1.jpg&quot;,&quot;sea_1.jpg&quot;,&quot;mountains_1.jpg&quot;,&quot;desert_2.jpg&quot;,&quot;jungle_2.jpg&quot;,&quot;sea_2.jpg&quot;,&quot;mountains_2.jpg&quot;]&amp;#10;curr_background=np.random.choice(backgrounds)" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="&amp;#10;        // add-on: list(s: string): string[]&amp;#10;        function list(s) {&amp;#10;            // if s is a string, we return a list of its characters&amp;#10;            if (typeof s === 'string')&amp;#10;                return s.split('');&amp;#10;            else&amp;#10;                // otherwise we return s:&amp;#10;                return s;&amp;#10;        }&amp;#10;&amp;#10;        import * as pd from 'pandas';&amp;#10;var SOA, SOA_AfterTraining, all_targets_df, auditory_nonword, backgrounds, conditions, curr_background, curr_block, fadeInTime, fadeOutTime, frameRate, max_jitter, nTrialsAfterTraining, nTrialsInBlock, n_blocks, n_correct, possible_answers, presentationTime, presentationTimeAfterTraining, reverse_nonword, reverse_nonwords, run, same_streak, subject_num, target_count_randomizer, targets_in_previous, total_probes, total_trials, training_blocks, version;&amp;#10;function eng_to_heb(df, wordlist) {&amp;#10;    var index_of_interest;&amp;#10;    for (var i, _pj_c = 0, _pj_a = util.range(wordlist.length), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;        i = _pj_a[_pj_c];&amp;#10;        index_of_interest = (df[&quot;target_eng&quot;] === wordlist[i]);&amp;#10;        wordlist[i] = df[&quot;target_heb&quot;][index_of_interest].item();&amp;#10;    }&amp;#10;    return list(wordlist);&amp;#10;}&amp;#10;function get_answers(df, word) {&amp;#10;    var answers, correct, index_of_interest, key, keys;&amp;#10;    index_of_interest = (np.array(df[&quot;target_eng&quot;]) === word);&amp;#10;    if ((np.sum(index_of_interest) !== 1)) {&amp;#10;        return &quot;nothing&quot;;&amp;#10;    }&amp;#10;    correct = df[&quot;correct&quot;][index_of_interest].iloc[0];&amp;#10;    answers = [df[&quot;option1&quot;][index_of_interest].iloc[0], df[&quot;option2&quot;][index_of_interest].iloc[0], df[&quot;option3&quot;][index_of_interest].iloc[0]];&amp;#10;    keys = [&quot;a&quot;, &quot;g&quot;, &quot;l&quot;];&amp;#10;    key = keys[np.where((np.array(answers) === np.array(correct)))[0][0]];&amp;#10;    answers.push(key);&amp;#10;    return answers;&amp;#10;}&amp;#10;expInfo[&quot;exp_version&quot;] = &quot;perceptual&quot;;&amp;#10;subject_num = Number.parseInt(expInfo[&quot;subject num&quot;]);&amp;#10;run = Number.parseInt(expInfo[&quot;run&quot;]);&amp;#10;version = &quot;ask_per_target&quot;;&amp;#10;n_blocks = 6;&amp;#10;training_blocks = 3;&amp;#10;if ((run === 2)) {&amp;#10;    n_blocks = 4;&amp;#10;    training_blocks = 1;&amp;#10;}&amp;#10;nTrialsInBlock = 18;&amp;#10;nTrialsAfterTraining = 215;&amp;#10;n_correct = 0;&amp;#10;total_trials = 1;&amp;#10;curr_block = 0;&amp;#10;same_streak = 0;&amp;#10;frameRate = 60;&amp;#10;fadeInTime = 0.1;&amp;#10;fadeOutTime = 0.1;&amp;#10;presentationTime = 0.9;&amp;#10;presentationTimeAfterTraining = 0.6;&amp;#10;targets_in_previous = 0;&amp;#10;target_count_randomizer = [19, 19, 19];&amp;#10;total_probes = np.sum(target_count_randomizer);&amp;#10;SOA = 1.9;&amp;#10;SOA_AfterTraining = 1.4;&amp;#10;max_jitter = 0.15;&amp;#10;conditions = np.repeat([&quot;catch&quot;, &quot;real_word&quot;, &quot;real_word&quot;], (total_probes / 3));&amp;#10;np.random.shuffle(conditions);&amp;#10;console.log(subject_num);&amp;#10;np.random.seed(subject_num);&amp;#10;all_targets_df = pd.read_csv(&quot;emotional_heb_words_sub.csv&quot;).sample({&quot;frac&quot;: 1}).slice(0, 39);&amp;#10;console.log(all_targets_df.length);&amp;#10;reverse_nonwords = pd.read_csv(&quot;reverse_nonwords.csv&quot;);&amp;#10;reverse_nonword = list(reverse_nonwords.sample(1)[&quot;auditory_nonword&quot;])[0];&amp;#10;auditory_nonword = list(reverse_nonwords.sample(1)[&quot;auditory_nonword&quot;])[0];&amp;#10;possible_answers = [&quot;\u05e4\u05e2\u05d5\u05dc\u05d4&quot;, &quot;\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05e7\u05d8\u05df&quot;, &quot;\u05ea\u05d7\u05d5\u05e9\u05d4&quot;, &quot;\u05d0\u05d9\u05e8\u05d5\u05e2&quot;, &quot;\u05de\u05d6\u05d5\u05df&quot;, &quot;\u05d0\u05d3\u05dd&quot;, &quot;\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05d2\u05d3\u05d5\u05dc&quot;, &quot;\u05ea\u05d9\u05d0\u05d5\u05e8&quot;, &quot;\u05d7\u05d9\u05d4&quot;, &quot;\u05e1\u05d9\u05de\u05df&quot;];&amp;#10;backgrounds = [&quot;desert_1.jpg&quot;, &quot;forest_1.jpg&quot;, &quot;city_1.jpg&quot;, &quot;jungle_1.jpg&quot;, &quot;sea_1.jpg&quot;, &quot;mountains_1.jpg&quot;, &quot;desert_2.jpg&quot;, &quot;jungle_2.jpg&quot;, &quot;sea_2.jpg&quot;, &quot;mountains_2.jpg&quot;];&amp;#10;curr_background = np.random.choice(backgrounds);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="#n_correct=0 #count each block for feedback&amp;#10;n_diff_correct=0 #count each block for feedback&amp;#10;q_idx=0&amp;#10;target_idx_in_block=0&amp;#10;i=0&amp;#10;count_visual_targets = 0&amp;#10;n_trials_performed=0&amp;#10;target_trials = np.zeros(nTrialsInBlock).astype(str)&amp;#10;expInfo[&quot;curr_block&quot;]=curr_block&amp;#10;n_correct=0 #zero training success per block&amp;#10;&amp;#10;if curr_block&gt;0:&amp;#10;    aud_volume=1&amp;#10;&amp;#10;if curr_block==training_blocks-1: #training with test&amp;#10;    presentationTime=presentationTimeAfterTraining&amp;#10;    SOA=SOA_AfterTraining&amp;#10;&amp;#10;if curr_block&gt;training_blocks-1: #if training is done&amp;#10;    nTrialsInBlock=nTrialsAfterTraining&amp;#10;    #set targets&amp;#10;    expInfo['correct_answer'] = ''&amp;#10;    expInfo['question_word'] = ''&amp;#10;    if version==&quot;ask_per_target&quot;:&amp;#10;        target_intervals=[10000]&amp;#10;        targets_in_block = target_count_randomizer[curr_block-training_blocks];&amp;#10;        #(minimum=7) sampled repeatedly from an exponential distribution &amp;#10;        # sample intervals until a sample is recieved with the last target 1 trial before ending the block&amp;#10;        block_conditions_list = conditions[targets_in_previous:(targets_in_previous+targets_in_block)]&amp;#10;        np.random.shuffle(block_conditions_list) &amp;#10;        expInfo[&quot;block_conditions_list&quot;]=block_conditions_list&amp;#10;        while(np.sum(target_intervals)&gt;(nTrialsInBlock-2)):&amp;#10;            target_trials = np.zeros(nTrialsInBlock).astype(str)&amp;#10;            exponential_dist = 7+np.random.exponential(7,2000)&amp;#10;            target_intervals = np.random.choice(exponential_dist, targets_in_block).astype(int)&amp;#10;        target_trials[np.cumsum(target_intervals)] = &quot;target&quot;&amp;#10;        target_trials[np.cumsum(target_intervals)+1] = &quot;test&quot;&amp;#10;if curr_block==0: #in the first block - no sound&amp;#10;    aud_volume=0&amp;#10;    targets_in_block=0&amp;#10;    &amp;#10;targets_in_previous=targets_in_previous+targets_in_block&amp;#10;n_targets = sum(target_trials=='target')&amp;#10;#if curr_block==0:&amp;#10;#    aud_volume=0&amp;#10;#else:&amp;#10;#    aud_volume=0.5&amp;#10;&amp;#10;played_targets = [] #will add targets name for awareness test&amp;#10;&amp;#10;curr_block=curr_block+1&amp;#10;&amp;#10;curr_background=np.random.choice(backgrounds)&amp;#10;background_sound = sound.Sound(&quot;stim\\auditory\\bubbles_bg_music.ogg&quot;, stereo=True, hamming=True,&amp;#10;    name='background_sound')" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="background_sound.stop()" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="background_sound.stop();&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
