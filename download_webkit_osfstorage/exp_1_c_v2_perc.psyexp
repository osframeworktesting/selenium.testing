        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="former_trial_is_target=0&amp;#10;play_catch=0&amp;#10;play_target=0&amp;#10;play_test=0&amp;#10;play_test_next=0&amp;#10;trial_feedback_txt=&quot;&quot;&amp;#10;auditory_target_name=&quot;zz&quot;&amp;#10;is_first_round=True&amp;#10;&amp;#10;#set greebles&amp;#10;greeble_list = [ 'stim/greebles/f3~310-a-v1.tif',&amp;#10; 'stim/greebles/f3~32-a-v1.tif',&amp;#10; 'stim/greebles/f3~33-a-v1.tif',&amp;#10; 'stim/greebles/f3~34-a-v1.tif',&amp;#10; 'stim/greebles/f3~35-a-v1.tif',&amp;#10; 'stim/greebles/f3~36-a-v1.tif',&amp;#10; 'stim/greebles/f3~37-a-v1.tif',&amp;#10; 'stim/greebles/f3~38-a-v1.tif',&amp;#10; 'stim/greebles/f3~39-a-v1.tif',&amp;#10; 'stim/greebles/f4~41-a-v1.tif',&amp;#10; 'stim/greebles/f4~42-a-v1.tif',&amp;#10; 'stim/greebles/f4~43-a-v1.tif',&amp;#10; 'stim/greebles/f4~44-a-v1.tif',&amp;#10; 'stim/greebles/f4~45-a-v1.tif',&amp;#10; 'stim/greebles/f4~46-a-v1.tif',&amp;#10; 'stim/greebles/f5~51-a-v1.tif',&amp;#10; 'stim/greebles/f5~510-a-v1.tif',&amp;#10; 'stim/greebles/f5~52-a-v1.tif',&amp;#10; 'stim/greebles/f5~53-a-v1.tif',&amp;#10; 'stim/greebles/f5~54-a-v1.tif',&amp;#10; 'stim/greebles/f5~55-a-v1.tif',&amp;#10; 'stim/greebles/f5~56-a-v1.tif',&amp;#10; 'stim/greebles/f5~57-a-v1.tif',&amp;#10; 'stim/greebles/f5~58-a-v1.tif',&amp;#10; 'stim/greebles/f5~59-a-v1.tif',&amp;#10; 'stim/greebles/m1~11-a-v1.tif',&amp;#10; 'stim/greebles/m1~110-a-v1.tif',&amp;#10; 'stim/greebles/m1~12-a-v1.tif',&amp;#10; 'stim/greebles/m1~13-a-v1.tif',&amp;#10; 'stim/greebles/m1~14-a-v1.tif',&amp;#10; 'stim/greebles/m1~15-a-v1.tif',&amp;#10; 'stim/greebles/m1~16-a-v1.tif',&amp;#10; 'stim/greebles/m1~17-a-v1.tif',&amp;#10; 'stim/greebles/m1~18-a-v1.tif',&amp;#10; 'stim/greebles/m1~19-a-v1.tif',&amp;#10; 'stim/greebles/m2~21-a-v1.tif',&amp;#10; 'stim/greebles/m2~210-a-v1.tif',&amp;#10; 'stim/greebles/m2~22-a-v1.tif',&amp;#10; 'stim/greebles/m2~23-a-v1.tif',&amp;#10; 'stim/greebles/m2~24-a-v1.tif',&amp;#10; 'stim/greebles/m2~25-a-v1.tif',&amp;#10; 'stim/greebles