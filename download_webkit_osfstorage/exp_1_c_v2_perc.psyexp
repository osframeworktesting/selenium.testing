        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="לאחר האימון, יושמעו קולות יחד עם המילים.&amp;#10;הקולות נועדו כדי לדמות סביבה רועשת, שאת השפעתה אנו בוחנים.&amp;#10;רוב הקולות יהיו צירופי הברות חסרי משמעות, אך מפעם לפעם&amp;#10;תושמע מילה בעלת משמעות.&amp;#10;&amp;#10;מדי פעם, נשאל אותך האם שמעת מילה בעלת משמעות&amp;#10; בכמה השניות האחרונות, ובאיזו מילה מדובר.&amp;#10;שימו לב! מילה בעלת משמעות לעולם לא תתאר שמות (אבי, דני...)&amp;#10;במילה בעלת משמעות תמיד יהיו לפחות שתי הברות.&amp;#10;&amp;#10;השאלה תמיד תתייחס למילה בעלת המשמעות האחרונה ששמעת.&amp;#10;לעיתים השאלה תופיע מעט (כמה שניות) אחרי מילה בעלת משמעות, ולעיתים לא&amp;#10;" valType="str" updates="constant" name="text"/>
