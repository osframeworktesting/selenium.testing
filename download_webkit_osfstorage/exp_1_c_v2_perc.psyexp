        <Param val="former_trial_is_target = 0;&amp;#10;play_catch = 0;&amp;#10;play_target = 0;&amp;#10;play_test = 0;&amp;#10;play_test_next = 0;&amp;#10;trial_feedback_txt = &quot;&quot;;&amp;#10;auditory_target_name = &quot;zz&quot;;&amp;#10;is_first_round = true;&amp;#10;greeble_list = [&quot;stim/greebles/f3~310-a-v1.tif&quot;, &quot;stim/greebles/f3~32-a-v1.tif&quot;, &quot;stim/greebles/f3~33-a-v1.tif&quot;, &quot;stim/greebles/f3~34-a-v1.tif&quot;, &quot;stim/greebles/f3~35-a-v1.tif&quot;, &quot;stim/greebles/f3~36-a-v1.tif&quot;, &quot;stim/greebles/f3~37-a-v1.tif&quot;, &quot;stim/greebles/f3~38-a-v1.tif&quot;, &quot;stim/greebles/f3~39-a-v1.tif&quot;, &quot;stim/greebles/f4~41-a-v1.tif&quot;, &quot;stim/greebles/f4~42-a-v1.tif&quot;, &quot;stim/greebles/f4~43-a-v1.tif&quot;, &quot;stim/greebles/f4~44-a-v1.tif&quot;, &quot;stim/greebles/f4~45-a-v1.tif&quot;, &quot;stim/greebles/f4~46-a-v1.tif&quot;, &quot;stim/greebles/f5~51-a-v1.tif&quot;, &quot;stim/greebles/f5~510-a-v1.tif&quot;, &quot;stim/greebles/f5~52-a-v1.tif&quot;, &quot;stim/greebles/f5~53-a-v1.tif&quot;, &quot;stim/greebles/f5~54-a-v1.tif&quot;, &quot;stim/greebles/f5~55-a-v1.tif&quot;, &quot;stim/greebles/f5~56-a-v1.tif&quot;, &quot;stim/greebles/f5~57-a-v1.tif&quot;, &quot;stim/greebles/f5~58-a-v1.tif&quot;, &quot;stim/greebles/f5~59-a-v1.tif&quot;, &quot;stim/greebles/m1~11-a-v1.tif&quot;, &quot;stim/greebles/m1~110-a-v1.tif&quot;, &quot;stim/greebles/m1~12-a-v1.tif&quot;, &quot;stim/greebles/m1~13-a-v1.tif&quot;, &quot;stim/greebles/m1~14-a-v1.tif&quot;, &quot;stim/greebles/m1~15-a-v1.tif&quot;, &quot;stim/greebles/m1~16-a-v1.tif&quot;, &quot;stim/greebles/m1~17-a-v1.tif&quot;, &quot;stim/greebles/m1~18-a-v1.tif&quot;, &quot;stim/greebles/m1~19-a-v1.tif&quot;, &quot;stim/greebles/m2~21-a-v1.tif&quot;, &quot;stim/greebles/m2~210-a-v1.tif&quot;, &quot;stim/greebles/m2~22-a-v1.tif&quot;, &quot;stim/greebles/m2~23-a-v1.tif&quot;, &quot;stim/greebles/m2~24-a-v1.tif&quot;, &quot;stim/greebles/m2~25-a-v1.tif&quot;, &quot;stim/greebles/m2~26-a-v1.tif&quot;, &quot;stim/greebles/m2~27-a-v1.tif&quot;, &quot;stim/greebles/m2~28-a-v1.tif&quot;, &quot;stim/greebles/m2~29-a-v1.tif&quot;, &quot;stim/greebles/m3~31-a-v1.tif&quot;, &quot;stim/greebles/m3~32-a-v1.tif&quot;, &quot;stim/greebles/m3~33-a-v1.tif&quot;, &quot;stim/greebles/m3~34-a-v1.tif&quot;, &quot;stim/greebles/m3~35-a-v1.tif&quot;, &quot;stim/greebles/m3~36-a-v1.tif&quot;, &quot;stim/greebles/m4~41-a-v1.tif&quot;, &quot;stim/greebles/m4~410-a-v1.tif&quot;, &quot;stim/greebles/m4~42-a-v1.tif&quot;, &quot;stim/greebles/m4~43-a-v1.tif&quot;, &quot;stim/greebles/m4~44-a-v1.tif&quot;, &quot;stim/greebles/m4~45-a-v1.tif&quot;, &quot;stim/greebles/m4~46-a-v1.tif&quot;, &quot;stim/greebles/m4~47-a-v1.tif&quot;, &quot;stim/greebles/m4~48-a-v1.tif&quot;, &quot;stim/greebles/m4~49-a-v1.tif&quot;, &quot;stim/greebles/m5~51-a-v1.tif&quot;, &quot;stim/greebles/m5~52-a-v1.tif&quot;, &quot;stim/greebles/m5~53-a-v1.tif&quot;, &quot;stim/greebles/m5~54-a-v1.tif&quot;, &quot;stim/greebles/m5~55-a-v1.tif&quot;, &quot;stim/greebles/m5~56-a-v1.tif&quot;];&amp;#10;greeble_model = np.random.choice(greeble_list);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="&amp;#10;        // add-on: list(s: string): string[]&amp;#10;        function list(s) {&amp;#10;            // if s is a string, we return a list of its characters&amp;#10;            if (typeof s === 'string')&amp;#10;                return s.split('');&amp;#10;            else&amp;#10;                // otherwise we return s:&amp;#10;                return s;&amp;#10;        }&amp;#10;&amp;#10;        trial_type = np.random.choice([&quot;up&quot;, &quot;up&quot;, &quot;up&quot;, &quot;down&quot;, &quot;down&quot;]);&amp;#10;expInfo[&quot;subj_resp.correct&quot;] = &quot;&quot;;&amp;#10;old_nonwords = [reverse_nonword, auditory_nonword];&amp;#10;reverse_nonword = list(reverse_nonwords.sample(1)[&quot;auditory_nonword&quot;])[0];&amp;#10;if ((reverse_nonword === old_nonwords[0])) {&amp;#10;    reverse_nonword = list(reverse_nonwords.sample(1)[&quot;auditory_nonword&quot;])[0];&amp;#10;}&amp;#10;auditory_nonword = list(reverse_nonwords.sample(1)[&quot;auditory_nonword&quot;])[0];&amp;#10;if ((auditory_nonword === old_nonwords[1])) {&amp;#10;    auditory_nonword = list(reverse_nonwords.sample(1)[&quot;auditory_nonword&quot;])[0];&amp;#10;}&amp;#10;if ((trial_type === &quot;up&quot;)) {&amp;#10;    correct_resp = &quot;k&quot;;&amp;#10;    greeble_oreintation = 0;&amp;#10;}&amp;#10;if ((trial_type === &quot;down&quot;)) {&amp;#10;    same_streak = 0;&amp;#10;    greeble_oreintation = 180;&amp;#10;    correct_resp = &quot;d&quot;;&amp;#10;}&amp;#10;new_greeble_candidate = np.random.choice(greeble_list);&amp;#10;if ((target_trials[i] === &quot;target&quot;)) {&amp;#10;    curr_cond = block_conditions_list[target_idx_in_block];&amp;#10;    if ((curr_cond === &quot;catch&quot;)) {&amp;#10;        play_catch = 1;&amp;#10;        play_target = 0;&amp;#10;        expInfo[&quot;valence_cond&quot;] = &quot;catch&quot;;&amp;#10;        category_resp_correct_ans = &quot;nothing&quot;;&amp;#10;        [ans1, ans2, ans3] = np.random.choice(possible_answers, 3, {&quot;replace&quot;: 0});&amp;#10;        target_idx_in_block += 1;&amp;#10;    } else {&amp;#10;        play_catch = 0;&amp;#10;        play_target = 1;&amp;#10;        auditory_target_name = all_targets_df[&quot;target_eng&quot;].iloc.slice((- 1))[0];&amp;#10;        auditory_target_file = (auditory_target_name + &quot;.ogg&quot;);&amp;#10;        answers = get_answers(all_targets_df, auditory_target_name);&amp;#10;        [ans1, ans2, ans3, category_resp_correct_ans] = answers;&amp;#10;        all_targets_df = all_targets_df.head((- 1));&amp;#10;        target_idx_in_block += 1;&amp;#10;    }&amp;#10;    expInfo[&quot;target_cat&quot;] = curr_cond;&amp;#10;} else {&amp;#10;    expInfo[&quot;target_cat&quot;] = &quot;nonword&quot;;&amp;#10;}&amp;#10;if ((target_trials[i] === &quot;test&quot;)) {&amp;#10;    play_test = 1;&amp;#10;} else {&amp;#10;    play_test = 0;&amp;#10;}&amp;#10;curr_auditory_onset = (max_jitter * np.random.uniform());&amp;#10;i += 1;&amp;#10;expInfo[&quot;i&quot;] = i;&amp;#10;expInfo[&quot;target_idx_in_block&quot;] = target_idx_in_block;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="trial_type=np.random.choice([&quot;up&quot;,&quot;up&quot;,&quot;up&quot;,&quot;down&quot;,&quot;down&quot;])&amp;#10;expInfo[&quot;subj_resp.correct&quot;]=&quot;&quot;&amp;#10;old_nonwords= [reverse_nonword,auditory_nonword]&amp;#10;reverse_nonword=list(reverse_nonwords.sample(1)[&quot;auditory_nonword&quot;])[0] #sample a random nonword for mask&amp;#10;if reverse_nonword==old_nonwords[0]:&amp;#10;    reverse_nonword=list(reverse_nonwords.sample(1)[&quot;auditory_nonword&quot;])[0] #sample a random nonword for trial onset&amp;#10;auditory_nonword=list(reverse_nonwords.sample(1)[&quot;auditory_nonword&quot;])[0] #sample a random nonword for trial onset&amp;#10;if auditory_nonword==old_nonwords[1]:&amp;#10;    auditory_nonword=list(reverse_nonwords.sample(1)[&quot;auditory_nonword&quot;])[0] #sample a random nonword for trial onset&amp;#10;&amp;#10;&amp;#10;if trial_type==&quot;up&quot;: #if we are showing the same greeble &amp;#10;    correct_resp=&quot;k&quot; #probability for aud_target after &quot;same&quot;&amp;#10;    greeble_oreintation=0&amp;#10;#    target_probability=0.08&amp;#10;if (trial_type==&quot;down&quot;):&amp;#10;    same_streak=0&amp;#10;    greeble_oreintation=180&amp;#10;    correct_resp=&quot;d&quot;&amp;#10;#    target_probability=0.24 #probability for aud_target after &quot;different&quot;&amp;#10;new_greeble_candidate = np.random.choice(greeble_list)#choose a new greeble&amp;#10;    &amp;#10;#if version==&quot;ask_per_target&quot;:&amp;#10;#    play_catch=0&amp;#10;#    play_prime=0&amp;#10;#    play_target=0&amp;#10;#    play_test=0&amp;#10;#    if (play_target|play_catch)&amp;(former_trial_is_target==0): #before setting the new trial, save whther the former is a target trial&amp;#10;#        former_trial_is_target=1&amp;#10;#        play_test=1&amp;#10;#    else: #if the former trial was not a target&amp;#10;#        former_trial_is_target=0&amp;#10;#        play_test=0&amp;#10;#    if int(target_trials[i])==1:#unless this trial is target and then never ask immediately&amp;#10;#        former_trial_is_target=0&amp;#10;#        play_test=0&amp;#10;&amp;#10;if target_trials[i]==&quot;target&quot;: # decide if we ask on catch trial or target&amp;#10;    curr_cond=block_conditions_list[target_idx_in_block]&amp;#10;    if curr_cond==&quot;catch&quot;:&amp;#10;        play_catch=1&amp;#10;        play_target=0&amp;#10;        expInfo[&quot;valence_cond&quot;]=&quot;catch&quot;&amp;#10;        category_resp_correct_ans=&quot;nothing&quot;&amp;#10;        ans1,ans2,ans3=np.random.choice(possible_answers,3,replace=0)&amp;#10;        target_idx_in_block+=1&amp;#10;    else:&amp;#10;        play_catch=0&amp;#10;        play_target=1&amp;#10;        auditory_target_name = all_targets_df[&quot;target_eng&quot;].iloc[-1]&amp;#10;        auditory_target_file = auditory_target_name+ &quot;.ogg&quot;&amp;#10;        #get the answers for objective question&amp;#10;        answers = get_answers(all_targets_df,auditory_target_name)&amp;#10;        ans1,ans2,ans3,category_resp_correct_ans=answers&amp;#10;        &amp;#10;        all_targets_df=all_targets_df.head(-1) #don't use this row again&amp;#10;        target_idx_in_block+=1&amp;#10;    expInfo[&quot;target_cat&quot;]=curr_cond&amp;#10;&amp;#10;else:# if not a target&amp;#10;    expInfo[&quot;target_cat&quot;]=&quot;nonword&quot;&amp;#10;&amp;#10;if target_trials[i]==&quot;test&quot;:&amp;#10;    play_test=1&amp;#10;else:&amp;#10;    play_test=0&amp;#10;#create onset jitter&amp;#10;curr_auditory_onset = max_jitter*np.random.uniform()&amp;#10;##sample random word to show&amp;#10;#random_word=np.random.choice(word_bank,1)[0]&amp;#10;#expInfo['random_word']=random_word&amp;#10;#save trial data&amp;#10;i+=1&amp;#10;expInfo['i']=i&amp;#10;expInfo['target_idx_in_block']=target_idx_in_block" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((i === nTrialsInBlock)) {&amp;#10;    trials_loop.finished = true;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if i==nTrialsInBlock:&amp;#10;    trials_loop.finished=True&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="set_trial_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="test">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="num" updates="None" name="durationEstim"/>
        <Param val="None" valType="str" updates="constant" name="flip"/>
        <Param val="Open Sans" valType="str" updates="constant" name="font"/>
        <Param val="LTR" valType="str" updates="None" name="languageStyle"/>
        <Param val="0.1" valType="num" updates="constant" name="letterHeight"/>
