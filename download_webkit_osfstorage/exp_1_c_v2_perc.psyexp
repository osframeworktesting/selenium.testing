      <CodeComponent name="set_correct_2">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="greeble_list = ['stim/greebles/f1~11-a-v1',&amp;#10; 'stim/greebles/f1~12-a-v1',&amp;#10; 'stim/greebles/f1~13-a-v1',&amp;#10; 'stim/greebles/f1~14-a-v1',&amp;#10; 'stim/greebles/f1~15-a-v1',&amp;#10; 'stim/greebles/f1~16-a-v1',&amp;#10; 'stim/greebles/f2~21-a-v1',&amp;#10; 'stim/greebles/f2~22-a-v1',&amp;#10; 'stim/greebles/f2~23-a-v1',&amp;#10; 'stim/greebles/f2~24-a-v1',&amp;#10; 'stim/greebles/f2~25-a-v1',&amp;#10; 'stim/greebles/f2~26-a-v1',&amp;#10; 'stim/greebles/f3~31-a-v1',&amp;#10; 'stim/greebles/f3~310-a-v1',&amp;#10; 'stim/greebles/f3~32-a-v1',&amp;#10; 'stim/greebles/f3~33-a-v1',&amp;#10; 'stim/greebles/f3~34-a-v1',&amp;#10; 'stim/greebles/f3~35-a-v1',&amp;#10; 'stim/greebles/f3~36-a-v1',&amp;#10; 'stim/greebles/f3~37-a-v1',&amp;#10; 'stim/greebles/f3~38-a-v1',&amp;#10; 'stim/greebles/f3~39-a-v1',&amp;#10; 'stim/greebles/f4~41-a-v1',&amp;#10; 'stim/greebles/f4~42-a-v1',&amp;#10; 'stim/greebles/f4~43-a-v1',&amp;#10; 'stim/greebles/f4~44-a-v1',&amp;#10; 'stim/greebles/f4~45-a-v1',&amp;#10; 'stim/greebles/f4~46-a-v1',&amp;#10; 'stim/greebles/f5~51-a-v1',&amp;#10; 'stim/greebles/f5~510-a-v1',&amp;#10; 'stim/greebles/f5~52-a-v1',&amp;#10; 'stim/greebles/f5~53-a-v1',&amp;#10; 'stim/greebles/f5~54-a-v1',&amp;#10; 'stim/greebles/f5~55-a-v1',&amp;#10; 'stim/greebles/f5~56-a-v1',&amp;#10; 'stim/greebles/f5~57-a-v1',&amp;#10; 'stim/greebles/f5~58-a-v1',&amp;#10; 'stim/greebles/f5~59-a-v1',&amp;#10; 'stim/greebles/m1~11-a-v1',&amp;#10; 'stim/greebles/m1~110-a-v1',&amp;#10; 'stim/greebles/m1~12-a-v1',&amp;#10; 'stim/greebles/m1~13-a-v1',&amp;#10; 'stim/greebles/m1~14-a-v1',&amp;#10; 'stim/greebles/m1~15-a-v1',&amp;#10; 'stim/greebles/m1~16-a-v1',&amp;#10; 'stim/greebles/m1~17-a-v1',&amp;#10; 'stim/greebles/m1~18-a-v1',&amp;#10; 'stim/greebles/m1~19-a-v1',&amp;#10; 'stim/greebles/m2~21-a-v1',&amp;#10; 'stim/greebles/m2~210-a-v1',&amp;#10; 'stim/greebles/m2~22-a-v1',&amp;#10; 'stim/greebles/m2~23-a-v1',&amp;#10; 'stim/greebles/m2~24-a-v1',&amp;#10; 'stim/greebles/m2~25-a-v1',&amp;#10; 'stim/greebles/m2~26-a-v1',&amp;#10; 'stim/greebles/m2~27-a-v1',&amp;#10; 'stim/greebles/m2~28-a-v1',&amp;#10; 'stim/greebles/m2~29-a-v1',&amp;#10; 'stim/greebles/m3~31-a-v1',&amp;#10; 'stim/greebles/m3~32-a-v1',&amp;#10; 'stim/greebles/m3~33-a-v1',&amp;#10; 'stim/greebles/m3~34-a-v1',&amp;#10; 'stim/greebles/m3~35-a-v1',&amp;#10; 'stim/greebles/m3~36-a-v1',&amp;#10; 'stim/greebles/m4~41-a-v1',&amp;#10; 'stim/greebles/m4~410-a-v1',&amp;#10; 'stim/greebles/m4~42-a-v1',&amp;#10; 'stim/greebles/m4~43-a-v1',&amp;#10; 'stim/greebles/m4~44-a-v1',&amp;#10; 'stim/greebles/m4~45-a-v1',&amp;#10; 'stim/greebles/m4~46-a-v1',&amp;#10; 'stim/greebles/m4~47-a-v1',&amp;#10; 'stim/greebles/m4~48-a-v1',&amp;#10; 'stim/greebles/m4~49-a-v1',&amp;#10; 'stim/greebles/m5~51-a-v1',&amp;#10; 'stim/greebles/m5~52-a-v1',&amp;#10; 'stim/greebles/m5~53-a-v1',&amp;#10; 'stim/greebles/m5~54-a-v1',&amp;#10; 'stim/greebles/m5~55-a-v1',&amp;#10; 'stim/greebles/m5~56-a-v1']&amp;#10;greeble_model = np.random.choice(greeble_list) #choose initial greeble" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="greeble_list = [&quot;stim/greebles/f1~11-a-v1&quot;, &quot;stim/greebles/f1~12-a-v1&quot;, &quot;stim/greebles/f1~13-a-v1&quot;, &quot;stim/greebles/f1~14-a-v1&quot;, &quot;stim/greebles/f1~15-a-v1&quot;, &quot;stim/greebles/f1~16-a-v1&quot;, &quot;stim/greebles/f2~21-a-v1&quot;, &quot;stim/greebles/f2~22-a-v1&quot;, &quot;stim/greebles/f2~23-a-v1&quot;, &quot;stim/greebles/f2~24-a-v1&quot;, &quot;stim/greebles/f2~25-a-v1&quot;, &quot;stim/greebles/f2~26-a-v1&quot;, &quot;stim/greebles/f3~31-a-v1&quot;, &quot;stim/greebles/f3~310-a-v1&quot;, &quot;stim/greebles/f3~32-a-v1&quot;, &quot;stim/greebles/f3~33-a-v1&quot;, &quot;stim/greebles/f3~34-a-v1&quot;, &quot;stim/greebles/f3~35-a-v1&quot;, &quot;stim/greebles/f3~36-a-v1&quot;, &quot;stim/greebles/f3~37-a-v1&quot;, &quot;stim/greebles/f3~38-a-v1&quot;, &quot;stim/greebles/f3~39-a-v1&quot;, &quot;stim/greebles/f4~41-a-v1&quot;, &quot;stim/greebles/f4~42-a-v1&quot;, &quot;stim/greebles/f4~43-a-v1&quot;, &quot;stim/greebles/f4~44-a-v1&quot;, &quot;stim/greebles/f4~45-a-v1&quot;, &quot;stim/greebles/f4~46-a-v1&quot;, &quot;stim/greebles/f5~51-a-v1&quot;, &quot;stim/greebles/f5~510-a-v1&quot;, &quot;stim/greebles/f5~52-a-v1&quot;, &quot;stim/greebles/f5~53-a-v1&quot;, &quot;stim/greebles/f5~54-a-v1&quot;, &quot;stim/greebles/f5~55-a-v1&quot;, &quot;stim/greebles/f5~56-a-v1&quot;, &quot;stim/greebles/f5~57-a-v1&quot;, &quot;stim/greebles/f5~58-a-v1&quot;, &quot;stim/greebles/f5~59-a-v1&quot;, &quot;stim/greebles/m1~11-a-v1&quot;, &quot;stim/greebles/m1~110-a-v1&quot;, &quot;stim/greebles/m1~12-a-v1&quot;, &quot;stim/greebles/m1~13-a-v1&quot;, &quot;stim/greebles/m1~14-a-v1&quot;, &quot;stim/greebles/m1~15-a-v1&quot;, &quot;stim/greebles/m1~16-a-v1&quot;, &quot;stim/greebles/m1~17-a-v1&quot;, &quot;stim/greebles/m1~18-a-v1&quot;, &quot;stim/greebles/m1~19-a-v1&quot;, &quot;stim/greebles/m2~21-a-v1&quot;, &quot;stim/greebles/m2~210-a-v1&quot;, &quot;stim/greebles/m2~22-a-v1&quot;, &quot;stim/greebles/m2~23-a-v1&quot;, &quot;stim/greebles/m2~24-a-v1&quot;, &quot;stim/greebles/m2~25-a-v1&quot;, &quot;stim/greebles/m2~26-a-v1&quot;, &quot;stim/greebles/m2~27-a-v1&quot;, &quot;stim/greebles/m2~28-a-v1&quot;, &quot;stim/greebles/m2~29-a-v1&quot;, &quot;stim/greebles/m3~31-a-v1&quot;, &quot;stim/greebles/m3~32-a-v1&quot;, &quot;stim/greebles/m3~33-a-v1&quot;, &quot;stim/greebles/m3~34-a-v1&quot;, &quot;stim/greebles/m3~35-a-v1&quot;, &quot;stim/greebles/m3~36-a-v1&quot;, &quot;stim/greebles/m4~41-a-v1&quot;, &quot;stim/greebles/m4~410-a-v1&quot;, &quot;stim/greebles/m4~42-a-v1&quot;, &quot;stim/greebles/m4~43-a-v1&quot;, &quot;stim/greebles/m4~44-a-v1&quot;, &quot;stim/greebles/m4~45-a-v1&quot;, &quot;stim/greebles/m4~46-a-v1&quot;, &quot;stim/greebles/m4~47-a-v1&quot;, &quot;stim/greebles/m4~48-a-v1&quot;, &quot;stim/greebles/m4~49-a-v1&quot;, &quot;stim/greebles/m5~51-a-v1&quot;, &quot;stim/greebles/m5~52-a-v1&quot;, &quot;stim/greebles/m5~53-a-v1&quot;, &quot;stim/greebles/m5~54-a-v1&quot;, &quot;stim/greebles/m5~55-a-v1&quot;, &quot;stim/greebles/m5~56-a-v1&quot;];&amp;#10;greeble_model = np.random.choice(greeble_list);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="startTime = globalClock.getTime();&amp;#10;curr_opacity = 0;&amp;#10;correct_resp = &quot;d&quot;;&amp;#10;if ((np.random.choice([&quot;same&quot;, &quot;different&quot;]) === &quot;same&quot;)) {&amp;#10;    correct_resp = &quot;s&quot;;&amp;#10;} else {&amp;#10;    new_greeble_candidate = np.random.choice(greeble_list);&amp;#10;    if ((new_greeble_candidate === greeble_model)) {&amp;#10;        new_greeble_candidate = np.random.choice(greeble_list);&amp;#10;    }&amp;#10;    if ((new_greeble_candidate === greeble_model)) {&amp;#10;        new_greeble_candidate = np.random.choice(greeble_list);&amp;#10;    }&amp;#10;    greeble_model = new_greeble_candidate;&amp;#10;}&amp;#10;opacity_after_peak = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="startTime = globalClock.getTime()&amp;#10;&amp;#10;curr_opacity=0&amp;#10;correct_resp=&quot;d&quot;&amp;#10;if np.random.choice([&quot;same&quot;,&quot;different&quot;])==&quot;same&quot;: #if we are showing the same greeble &amp;#10;    correct_resp=&quot;s&quot;&amp;#10;else: #choose a new greeble&amp;#10;    new_greeble_candidate = np.random.choice(greeble_list)&amp;#10;    if new_greeble_candidate==greeble_model: #1/80 chance to choose the same greeble&amp;#10;        new_greeble_candidate = np.random.choice(greeble_list)&amp;#10;    if new_greeble_candidate==greeble_model:&amp;#10;        new_greeble_candidate = np.random.choice(greeble_list)&amp;#10;    greeble_model = new_greeble_candidate&amp;#10;    &amp;#10;    &amp;#10;opacity_after_peak = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="if curr_opacity&gt;=1:&amp;#10;    opacity_after_peak = True&amp;#10;    curr_opacity=1&amp;#10;&amp;#10;if not opacity_after_peak:&amp;#10;    curr_opacity+=1/20 #this means opacity will change by frame rate! for 144 &amp;#10;    #1/40 with 144 hz means that after 40/144=278 ms we reach maximum opacity&amp;#10;&amp;#10;if t&gt;0.7:#globalClock.getTime()-startTime&gt;0.7&amp;#10;    curr_opacity=curr_opacity-1/20 &amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((curr_opacity &gt;= 1)) {&amp;#10;    opacity_after_peak = true;&amp;#10;    curr_opacity = 1;&amp;#10;}&amp;#10;if ((! opacity_after_peak)) {&amp;#10;    curr_opacity += (1 / 20);&amp;#10;}&amp;#10;if ((t &gt; 0.7)) {&amp;#10;    curr_opacity = (curr_opacity - (1 / 20));&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="set_correct_2" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <ImageComponent name="greeble_img_2">
        <Param val="center" valType="str" updates="constant" name="anchor"/>
        <Param val="$[1,1,1]" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="num" updates="None" name="durationEstim"/>
        <Param val="False" valType="bool" updates="constant" name="flipHoriz"/>
        <Param val="False" valType="bool" updates="constant" name="flipVert"/>
        <Param val="$greeble_model" valType="file" updates="set every repeat" name="image"/>
        <Param val="linear" valType="str" updates="constant" name="interpolate"/>
        <Param val="" valType="str" updates="constant" name="mask"/>
        <Param val="greeble_img_2" valType="code" updates="None" name="name"/>
        <Param val="curr_opacity" valType="num" updates="set every frame" name="opacity"/>
        <Param val="np.random.choice(np.arange(-30,30))" valType="num" updates="set every repeat" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="(0.3, 0.3)" valType="list" updates="constant" name="size"/>
        <Param val="" valType="num" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0" valType="num" updates="None" name="startVal"/>
