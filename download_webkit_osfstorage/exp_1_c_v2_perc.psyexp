        <Param val="background_sound.stop();&amp;#10;words = [auditory_target_name, never_played_targets.slice((- 1))[0], never_played_targets.slice((- 2))[0]];&amp;#10;never_played_targets = never_played_targets.slice(0, (- 2));&amp;#10;if ((auditory_target_name === &quot;&quot;)) {&amp;#10;    words[0] = never_played_targets.slice((- 1))[0];&amp;#10;    auditory_target_name = never_played_targets.slice((- 1))[0];&amp;#10;    never_played_targets = never_played_targets.slice(0, (- 1));&amp;#10;}&amp;#10;np.random.shuffle(words);&amp;#10;correct_resp_awareness_obj = (1 + np.where((np.array(words) === auditory_target_name))[0][0]);&amp;#10;expInfo[&quot;correct_resp_awareness_obj&quot;] = correct_resp_awareness_obj;&amp;#10;words = eng_to_heb(all_targets_df, words);&amp;#10;expInfo[&quot;words_in_q&quot;] = words;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
